# ==============================================================================
# .gitignore - Masdika.ID
# Mencegah file kredensial sensitif, build cache, dynamic storage, dan junk ter-commit
# ==============================================================================

# ─── 1. Kredensial Sensitif, Kunci, & Secrets (SANGAT KRUSIAL) ───
.env
.env.*
*.env
*.env.local
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Kunci SSH, Sertifikat, Token & Skrip Rahasia
*.pem
*.key
*.cert
*.crt
*.pub
id_rsa*
**/id_rsa*
id_ed25519*
**/id_ed25519*
set_secrets.bat
*secret*.bat
*secret*.sh
*secrets*

# ─── 2. Storage Dinamis & File Upload Pengguna ───
# Seluruh folder uploads dan storage dinamis (SSH keys generated, tickets, secure media)
apps/web/public/uploads/**
!apps/web/public/uploads/.gitkeep
!apps/web/public/uploads/**/.gitkeep
public/uploads/**
!public/uploads/.gitkeep
!public/uploads/**/.gitkeep

apps/web/storage/**
!apps/web/storage/.gitkeep
!apps/web/storage/**/.gitkeep
storage/**
!storage/.gitkeep
!storage/**/.gitkeep
**/storage/**
!**/storage/**/.gitkeep

# ─── 3. Database Data, Cache & Backup Dumps ───
postgres_data/
redis_data/
grafana_data/
prometheus_data/
elasticsearch_data/
mysql_data/
mysql_shared_data/
postgres_shared_data/
mongo_shared_data/

*.sql
*.sql.gz
*.dump
*.bak
*.backup
*.sqlite
*.sqlite3
apps/web/prisma/*.db
apps/web/prisma/*.db-journal
/src/generated/prisma

# ─── 4. Dependencies & Package Managers ───
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── 5. Next.js, Build Output, & Cache ───
.next/
**/.next/
out/
build/
dist/
.vercel/
.turbo/
*.tsbuildinfo
next-env.d.ts

# ─── 6. Testing & Coverage ───
coverage/
**/coverage/

# ─── 7. Log & Debug Files ───
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
*.report.json
*_report*.json
debug_*.json

# ─── 8. File Scratch, Temporary, & Pengujian Lokal ───
scratch/
**/scratch/
/test.js
/test.ts
/_test_*
*.tmp
*.temp

# ─── 9. IDE, Editor & OS Junk Files ───
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/